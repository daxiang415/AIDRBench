# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Environments and local tooling
.venv/
.env
.env.*
!.env.example
.idea/
.vscode/
.DS_Store
._*

# Downloaded or generated data
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*.parquet
data/processed/*.csv

# Experiment artifacts
results/**
!results/**/
!results/**/.gitkeep
!results/_build_figure_revision_package.py

# External repositories and large runtime artifacts
external/
*.log
*.aux
*.toc
*.pid
*.zip
*.tar
*.tar.gz

# Keep manifests and documentation tracked
!data/manifests/**
!docs/**

# Large local full-data releases; regenerate TIFF from summary tables.
*.tiff
*.tif
*.parquet
manuscript/source_data/**/ready_hourly_curves.csv
manuscript/source_data/**/recovery_inputs/
manuscript/source_data/**/hourly/
