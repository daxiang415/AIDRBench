.coverage
htmlcov/

# Environments and local tooling
.venv/
.env
.env.*
!.env.example
.idea/
.vscode/
.DS_Store
._*

# Downloaded or generated data
data/raw/*
!data/raw/.gitkeep
data/interim/*
