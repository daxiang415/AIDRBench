external/
*.log
*.aux
*.toc
*.pid
*.zip
*.tar
*.tar.gz

# Keep manifests and documentation tracked
!data/manifests/**
!docs/**

# Large local full-data releases; regenerate TIFF from summary tables.
*.tiff
*.tif
*.parquet
manuscript/source_data/**/ready_hourly_curves.csv
manuscript/source_data/**/recovery_inputs/
manuscript/source_data/**/hourly/

# Small frozen fixtures and plotted summary curves are included intentionally.
!data/calibration/**/*.parquet
!data/examples/**/*.parquet
!manuscript/source_data/**/ready_hourly_curves.csv
!results/exports/AIDRBench_Figure6_WebGPT_v2.zip
!results/exports/AIDRBench_Supplementary_Figure_S5_WebGPT_v1.zip

