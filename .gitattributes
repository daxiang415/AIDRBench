# Preserve byte-identical scientific inputs and frozen portable deliveries.
* -text
*.pdf binary
*.png binary
*.jpg binary
*.pptx binary
*.xlsx binary
*.parquet binary

# Frozen CSV bytes include CRLF; generated SVG paths include trailing spaces.
*.csv whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.svg -whitespace
*.bat whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
